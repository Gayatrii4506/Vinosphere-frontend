generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  WINERY
  CORPORATE
  ADMIN
}
