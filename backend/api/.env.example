# VinoSphere Express Backend API Environment Configuration Example
# Copy to .env for local development or set in Render/Railway dashboard

PORT=5000
NODE_ENV=production

# Strict CORS Allowlist (comma-separated production URLs for our 3 applications)
CORS_ORIGIN=https://vinosphere-consumer.vercel.app,https://vinosphere-winery.vercel.app,https://vinosphere-admin.vercel.app

# Supabase PostgreSQL Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Custom JWT Secret (for Winery Dashboard auth sessions)
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars

# Python ML Microservice URLs (Optional)
WINE_QUALITY_ML_URL=your_wine_quality_ml_url
FOOD_RECOMMENDATION_ML_URL=your_food_recommendation_ml_url

# Optional Email & Notification Services (SMTP)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM=noreply@vinosphere.in
WINERY_DASHBOARD_URL=https://vinosphere-winery.vercel.app
