{
    "name": "vinosopher",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npm --prefix frontend/consumer run dev",
        "dev:consumer": "npm --prefix frontend/consumer run dev",
        "dev:backend": "npm --prefix backend/api run dev",
        "dev:winery": "npm --prefix frontend/winery-dashboard run dev",
        "dev:admin": "npm --prefix frontend/admin-dashboard run dev",
        "dev:pairing": "npm --prefix backend/ml-services/food-recommendation/legacy_frontend run dev",
        "dev:food-api": "cd backend/ml-services/food-recommendation && .\\venv\\Scripts\\python.exe -m uvicorn api.main:app --reload --port 8000",
        "dev:all": "npx concurrently -n \"BACKEND,FOOD-API,WINERY,ADMIN,CONSUMER\" -c \"bgMaroon.bold,bgGreen.bold,bgGold.bold,bgMagenta.bold,bgBlue.bold\" \"npm run dev:backend\" \"npm run dev:food-api\" \"npm run dev:winery\" \"npm run dev:admin\" \"npm run dev:consumer\"",
        "test:backend": "npm --prefix backend/api test",
        "seed:sula": "npm --prefix backend/api run seed:sula",
        "build:consumer": "npm --prefix frontend/consumer run build",
        "build:winery": "npm --prefix frontend/winery-dashboard run build",
        "build:admin": "npm --prefix frontend/admin-dashboard run build",
        "build:backend": "npm --prefix backend/api run build",
        "build": "npm run build:consumer",
        "start": "npm --prefix frontend/consumer run start",
        "lint": "npm --prefix frontend/consumer run lint"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.1",
        "@radix-ui/react-dropdown-menu": "^2.0.5",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.109.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "framer-motion": "^11.0.0",
        "helmet": "^8.3.0",
        "lucide-react": "^0.408.0",
        "next": "^15.0.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "recharts": "^3.10.1",
        "tailwind-merge": "^2.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^20.19.43",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "autoprefixer": "^10.4.16",
        "eslint": "^9.0.0",
        "eslint-config-next": "^15.0.0",
        "postcss": "^8.4.31",
        "prisma": "^6.19.3",
        "tailwindcss": "^3.4.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    }
