# VinoSphere Consumer Application Environment Configuration Example
# Copy to .env.local for local development or set as environment variables in Vercel/production

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Canonical Application Site URL for Authentication Redirects (OAuth & Email Confirm)
# Local: defaults to http://localhost:3000
# Production (Vercel): https://vinosphere-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=https://vinosphere-frontend.vercel.app

# Backend Express API Base URL (e.g., https://api.vinosphere.app/api/v1)
NEXT_PUBLIC_BACKEND_URL=your_backend_api_url

# FastAPI Food Recommendation Microservice Base URL (e.g., https://food-rec.vinosphere.app)
NEXT_PUBLIC_API_URL=your_food_recommendation_ml_service_url
